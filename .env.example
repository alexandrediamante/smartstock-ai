# SmartStock AI - Environment Variables
# Copy to .env and fill in values

# Application
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# Database
DATABASE_URL=sqlite:///./data/smartstock.db

# OpenAI (optional - fallback works without)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=30

# CORS
CORS_ORIGINS=http://localhost:5173,http://smartstock.adsystem.dev.br

# Import settings
IMPORT_BATCH_SIZE=1000
IMPORT_DATE_FORMAT=%d/%m/%Y
IMPORT_DECIMAL_SEPARATOR=,

# Alert thresholds (configurable)
ALERT_EXPIRATION_CRITICAL_DAYS=3
ALERT_EXPIRATION_WARNING_DAYS=7
ALERT_FINANCIAL_EXPOSURE_CRITICAL=10000
ALERT_FINANCIAL_EXPOSURE_WARNING=5000
ALERT_STOCKOUT_CRITICAL_DAYS=2
ALERT_STOCKOUT_WARNING_DAYS=5

# Replenishment defaults
DEFAULT_LEAD_TIME_DAYS=7
DEFAULT_SAFETY_STOCK_DAYS=3

# Frontend
VITE_API_URL=http://localhost:8000